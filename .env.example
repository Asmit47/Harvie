# Required for NVIDIA hosted endpoints. Optional for self-hosted NIM if auth is disabled.
NVIDIA_API_KEY=

# Optional - Tier 1B Mem0 memory
MEM0_API_KEY=

# Optional - Tier 3 Supermemory knowledge base
SUPERMEMORY_API_KEY=

# Optional - Composio-backed Gmail and Google Calendar integrations.
# Connect Gmail/Calendar accounts in Composio for this user ID.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=default_user
# Optional writable SDK cache directory. Defaults to data/composio-cache.
COMPOSIO_CACHE_DIR=

# Optional overrides
NEXUS_USER_ID=default_user
NEXUS_LLM_MODEL=z-ai/glm-5.2
# For self-hosted NVIDIA NIM, use the OpenAI-compatible root URL.
# Example: http://localhost:8000/v1
NVIDIA_BASE_URL=
