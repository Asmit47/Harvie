# Required for the primary chat model.
GROQ_API_KEY=

# Required for fallback and small-check model usage.
GOOGLE_API_KEY=

# Optional - Tier 3 Supermemory knowledge base
SUPERMEMORY_API_KEY=

# Optional - Composio-backed Gmail and Google Calendar integrations.
# Connect Gmail/Calendar accounts in Composio for this user ID.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=default_user
# Optional writable SDK cache directory. Defaults to data/composio-cache.
COMPOSIO_CACHE_DIR=

# Optional overrides
HARVIE_USER_ID=default_user
HARVIE_API_PROXY_SECRET=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GOOGLE_LLM_MODEL=gemini-3.5-flash

# Clerk Authentication (Frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SESSION_TTL_HOURS=48
SESSION_CONTEXT_MAX_CHARS=12000
PERSONA_CONTEXT_MAX_CHARS=3000
SUPERMEMORY_CONTEXT_LIMIT=5
OPEN_LOOP_CONTEXT_LIMIT=5
ATTENTION_LOOKAHEAD_HOURS=48

# LangSmith observability
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=harvie
