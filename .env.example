# Required for the primary chat model.
GROQ_API_KEY=

# Required for fallback and small-check model usage.
GOOGLE_API_KEY=

# Optional - Tier 3 Supermemory knowledge base
SUPERMEMORY_API_KEY=

# Optional - Composio-backed Gmail and Google Calendar integrations.
# Connect Gmail/Calendar accounts in Composio for this user ID.
COMPOSIO_API_KEY=
# Optional local CLI fallback only. Production uses the authenticated Clerk ID.
COMPOSIO_USER_ID=
# Optional writable SDK cache directory. Defaults to data/composio-cache.
COMPOSIO_CACHE_DIR=

# Shared Security / Authentication Proxy
# Generate a strong shared secret (e.g., openssl rand -hex 32)
# Set identical value on Render (backend) and Vercel (frontend).
HARVIE_API_PROXY_SECRET=

# PostgreSQL connection (required)
# Local dev default; Render auto-injects via render.yaml
DATABASE_URL=postgresql://localhost:5432/harvie

# Optional: Comma-separated allowed origins if direct CORS is needed (e.g. https://your-app.vercel.app)
HARVIE_ALLOWED_ORIGINS=

# Optional overrides
# Optional local CLI fallback. Browser requests use the authenticated Clerk ID.
HARVIE_USER_ID=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GOOGLE_LLM_MODEL=gemini-3.5-flash

# Frontend (Vercel) Environment Variables
# REQUIRED in production on Vercel (points to Render service URL, e.g. https://harvie-api.onrender.com)
HARVIE_API_URL=
# Clerk Authentication (Frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SESSION_TTL_HOURS=48
SESSION_CONTEXT_MAX_CHARS=12000
PERSONA_CONTEXT_MAX_CHARS=3000
SUPERMEMORY_CONTEXT_LIMIT=5
OPEN_LOOP_CONTEXT_LIMIT=5
ATTENTION_LOOKAHEAD_HOURS=48

# LangSmith observability
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=harvie
