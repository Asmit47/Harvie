# Required for the primary chat model.
GROQ_API_KEY=

# Required for fallback and small-check model usage.
GOOGLE_API_KEY=

# Optional - Tier 1B Mem0 memory
MEM0_API_KEY=

# Optional - Tier 3 Supermemory knowledge base
SUPERMEMORY_API_KEY=

# Optional - Composio-backed Gmail and Google Calendar integrations.
# Connect Gmail/Calendar accounts in Composio for this user ID.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=default_user
# Optional writable SDK cache directory. Defaults to data/composio-cache.
COMPOSIO_CACHE_DIR=

# Optional overrides
NEXUS_USER_ID=default_user
GROQ_LLM_MODEL=openai/gpt-oss-120b
GOOGLE_LLM_MODEL=gemini-3.5-flash

# LangSmith observability
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexus
